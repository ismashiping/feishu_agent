# Local dependency research cache; never source or a lockfile.
.research-cache/

# Isolated tools, interpreter, environments and generated artifacts.
.tools/
.venv/
# Reproducible scratch/cache only for new runs; permanent evidence belongs in docs.
# Existing .artifacts acceptance records are preserved, not cleanup candidates.
/.artifacts/
dist/
build/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
# Disposable root-level pytest basetemp directories; historical tracked files stay tracked.
/.pytest_*/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local credentials and runtime data; keep small test fixtures trackable.
.env
.env.*
!.env.example
data/
models/
logs/
.venv-p117/
.venv-p117-prior/
.venv-p117-partial/

.uv-fulltext-cache/
.pytest_fulltext*/

# Local stage-2 verification sandboxes
.pytest_openalex*/

# Local stage-3 verification sandboxes
.pytest_oa_stage3*/
.pytest_oa_exercise*/
