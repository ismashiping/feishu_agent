# Documentation only: the application does not automatically load .env files.
# Set these environment variables explicitly in the calling process.
CLINICAL_AGENT_APP_ENV=development
CLINICAL_AGENT_LOG_LEVEL=INFO

# Optional PostgreSQL configuration; used only when explicitly constructing DatabaseSettings.
CLINICAL_AGENT_DB_HOST=127.0.0.1
CLINICAL_AGENT_DB_PORT=55432
CLINICAL_AGENT_DB_NAME=clinical_agent
CLINICAL_AGENT_DB_USER=clinical_agent
# Set CLINICAL_AGENT_DB_PASSWORD in the process environment; never commit a real password.

# Optional DeepSeek configuration; only read when constructing DeepSeekSettings.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Set DEEPSEEK_API_KEY in the process environment; never commit a real key.

# Optional API configuration. Existing model/import directories are required at startup.
CLINICAL_AGENT_API_MODEL_DIR=models/multilingual-e5-base/d128750597153bb5987e10b1c3493a34e5a4502a
CLINICAL_AGENT_API_IMPORT_ROOT=data/incoming
CLINICAL_AGENT_API_SNAPSHOT_DIR=data/snapshots
CLINICAL_AGENT_API_MAX_IN_FLIGHT=2
CLINICAL_AGENT_API_MAX_REQUEST_BYTES=16384
